<?xml version="1.0" encoding="utf-8" ?>
<schemalist>
  <schema
        id="org.gnome.shell.extensions.apptab"
        path="/org/gnome/shell/extensions/apptab/"
    >
       <key name="panel-height" type="i">
           <default>32</default>
           <summary>Height of the panel</summary>
       </key>
       <key name="show-all-windows" type="b">
           <default>false</default>
           <summary>Show windows from all workspaces.</summary>
       </key>
       <key name="focus-next-window" type="as">
           <default><![CDATA[['<Super>j']]]></default>
            <summary>Keybinding to focus the next window.</summary>
       </key>
       <key name="focus-previous-window" type="as">
           <default><![CDATA[['<Super>k']]]></default>
            <summary>Keybinding to focus the previous window.</summary>
       </key>
    </schema>
</schemalist>
